APP_NAME=ProjMulti
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tin-projmulti.einet.ch
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_PORT=8080

LOG_CHANNEL=daily
LOG_LEVEL=info

# Base MySQL du conteneur « db » (compose.yaml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=projmulti
DB_PASSWORD=
DB_ROOT_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Keycloak HEIG-VD (clé publique du realm, sans les lignes BEGIN/END)
KEYCLOAK_REALM_PUBLIC_KEY=
KEYCLOAK_USER_PROVIDER_CREDENTIAL=email
KEYCLOAK_TOKEN_PRINCIPAL_ATTRIBUTE=email

# Annuaire LDAP de l'école (création des comptes à la première connexion)
LDAP_SERVER=ldaps://ldaps.heig-vd.ch:636/
LDAP_USER=iai-ldap
LDAP_PASSWORD=
LDAP_BASE_DN="DC=einet,DC=ad,DC=eivd,DC=ch"

# Développement local uniquement (APP_ENV=local, APP_DEBUG=true) : id de l'utilisateur connecté d'office.
# Le header HTTP X-Dev-User: <id> permet aussi de changer d'utilisateur.
ID_USER=
